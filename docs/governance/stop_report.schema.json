{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KRONOS stop-report (5W+1H)",
  "$comment": "Fail-closed version discrimination. contract_version is REQUIRED (via allOf) and MUST be one of the recognized schema-bound versions in its enum. A missing, non-string, or unrecognized/malformed value (e.g. '1.4.0 ', ' 1.4.0', 'v1.4.0', '1.4', unknown future versions) is REJECTED, never silently validated as legacy. The recognized legacy versions 1.3.0/1.3.1/1.3.2 are exactly the shipped versions that share the current eleven-required-key, five-decision-class object introduced at contract v1.3.0; they validate against the permissive base. Exact 1.4.0, 1.4.1, 1.4.2, and 1.4.3 each additionally satisfy the strict then-branch (when.milestone, how.reference_ledger, effort_justification; when/how closed). Historical unversioned terminal reports remain historical evidence and are not schema-valid v1.4.0/v1.4.1/v1.4.2 report objects; no historical record is rewritten or migrated. v1.4.0/v1.4.1/v1.4.2/v1.4.3 validation is never loosened.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "what",
    "why",
    "who",
    "when",
    "where",
    "how",
    "next",
    "recommendation",
    "operator_action",
    "decision_class",
    "opus_effort"
  ],
  "properties": {
    "report_type": {
      "type": "string",
      "enum": [
        "PAUSE",
        "HALT",
        "BLOCKED",
        "COMPLETE"
      ]
    },
    "contract_version": {
      "type": "string",
      "enum": [
        "1.3.0",
        "1.3.1",
        "1.3.2",
        "1.4.0",
        "1.4.1",
        "1.4.2",
        "1.4.3",
        "1.4.4"
      ]
    },
    "decision_class": {
      "type": "string",
      "enum": [
        "AUTO-CONTINUE",
        "SAFE-TO-APPROVE",
        "REVIEW-REQUIRED",
        "HOLD",
        "NO-ACTION"
      ]
    },
    "opus_effort": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "completion_record": {
      "$comment": "OPTIONAL per contract v1.4.4 §13.4. A loop-drafted record is inert until an operator COMPLETION-GATE supplies the activation fields; agents never self-certify. certified_main_sha binds the record to an exact main HEAD; any drift invalidates it. evidence_digest is a sha256 over the per-milestone citation set only (non-circular), never over the activation fields.",
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "reopened",
            "cleared"
          ]
        },
        "certified_main_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dod_version": {
          "type": "string"
        },
        "kronos_done_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "milestones": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "G1",
              "G2",
              "G3"
            ]
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "milestone_id": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "milestone_id",
                "evidence"
              ]
            }
          }
        }
      },
      "required": [
        "state",
        "certified_main_sha",
        "dod_version",
        "kronos_done_sha256",
        "evidence_digest",
        "milestones"
      ]
    },
    "effort_justification": {
      "type": "string"
    },
    "what": {
      "type": "string"
    },
    "why": {
      "type": "string",
      "enum": [
        "usage_limit",
        "gate1",
        "gate2",
        "blocker",
        "failure",
        "completion"
      ]
    },
    "who": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array"
        },
        "models": {
          "type": "array"
        }
      }
    },
    "when": {
      "type": "object",
      "properties": {
        "checkpoint_seq": {
          "type": "integer"
        },
        "timestamp": {
          "type": "string"
        },
        "milestone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locked_baseline",
            "numerator",
            "denominator",
            "percentage",
            "remaining_gates",
            "eta_assumptions",
            "confidence"
          ],
          "properties": {
            "locked_baseline": {
              "type": "string"
            },
            "numerator": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            },
            "denominator": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            },
            "percentage": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            },
            "remaining_gates": {
              "type": "array"
            },
            "eta_assumptions": {
              "type": "string"
            },
            "confidence": {
              "type": "string"
            }
          }
        }
      }
    },
    "where": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "pr": {
          "type": [
            "string",
            "null"
          ]
        },
        "main": {
          "type": "string"
        }
      }
    },
    "how": {
      "type": "object",
      "required": [
        "tests",
        "gates"
      ],
      "properties": {
        "tests": {},
        "gates": {},
        "reference_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicable",
            "entries"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "pinned_sha",
                  "evidence_id",
                  "license_privacy",
                  "epistemic_status",
                  "goal_mapping",
                  "clean_room_evolution",
                  "disposition",
                  "implementation_status"
                ],
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "pinned_sha": {
                    "type": "string"
                  },
                  "evidence_id": {
                    "type": "string"
                  },
                  "license_privacy": {
                    "type": "string"
                  },
                  "epistemic_status": {
                    "enum": [
                      "Observed",
                      "Inferred",
                      "Unknown"
                    ]
                  },
                  "goal_mapping": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "G1",
                        "G2",
                        "G3"
                      ]
                    }
                  },
                  "clean_room_evolution": {
                    "type": "string"
                  },
                  "disposition": {
                    "enum": [
                      "Adopt",
                      "Adapt",
                      "Defer",
                      "Investigate",
                      "Reject"
                    ]
                  },
                  "implementation_status": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "applicable": {
                "const": false
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "entries": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    "next": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "severity",
          "depends_on",
          "action",
          "decision_class"
        ],
        "properties": {
          "rank": {
            "type": "integer"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string"
          },
          "decision_class": {
            "type": "string",
            "enum": [
              "AUTO-CONTINUE",
              "SAFE-TO-APPROVE",
              "REVIEW-REQUIRED",
              "HOLD",
              "NO-ACTION"
            ]
          }
        }
      }
    },
    "recommendation": {
      "type": "string"
    },
    "operator_action": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "contract_version": {
        "enum": [
          "1.4.0",
          "1.4.1",
          "1.4.2",
          "1.4.3",
          "1.4.4"
        ]
      }
    },
    "required": [
      "contract_version"
    ]
  },
  "then": {
    "required": [
      "contract_version",
      "effort_justification"
    ],
    "properties": {
      "when": {
        "required": [
          "checkpoint_seq",
          "timestamp",
          "milestone"
        ],
        "additionalProperties": false,
        "properties": {
          "checkpoint_seq": {},
          "timestamp": {},
          "milestone": {}
        }
      },
      "how": {
        "required": [
          "tests",
          "gates",
          "reference_ledger"
        ],
        "additionalProperties": false,
        "properties": {
          "tests": {},
          "gates": {},
          "reference_ledger": {}
        }
      }
    }
  },
  "allOf": [
    {
      "required": [
        "contract_version"
      ]
    }
  ]
}
