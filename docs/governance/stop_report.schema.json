{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KRONOS stop-report (5W+1H)",
  "$comment": "Version-discriminated. Legacy reports (no contract_version, or a value other than 1.4.0) validate against the permissive base only, with when/where/how open, preserving historical-report compatibility unchanged. Reports declaring contract_version 1.4.0 MUST additionally satisfy the strict extension in the then-branch: when and how are closed to their declared keys (no unbounded catch-all), with when.milestone, how.reference_ledger, and effort_justification required. v1.4.0 validation is never loosened.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "what",
    "why",
    "who",
    "when",
    "where",
    "how",
    "next",
    "recommendation",
    "operator_action",
    "decision_class",
    "opus_effort"
  ],
  "properties": {
    "report_type": {
      "type": "string",
      "enum": [
        "PAUSE",
        "HALT",
        "BLOCKED",
        "COMPLETE"
      ]
    },
    "contract_version": {
      "type": "string"
    },
    "decision_class": {
      "type": "string",
      "enum": [
        "AUTO-CONTINUE",
        "SAFE-TO-APPROVE",
        "REVIEW-REQUIRED",
        "HOLD",
        "NO-ACTION"
      ]
    },
    "opus_effort": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "effort_justification": {
      "type": "string"
    },
    "what": {
      "type": "string"
    },
    "why": {
      "type": "string",
      "enum": [
        "usage_limit",
        "gate1",
        "gate2",
        "blocker",
        "failure",
        "completion"
      ]
    },
    "who": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array"
        },
        "models": {
          "type": "array"
        }
      }
    },
    "when": {
      "type": "object",
      "properties": {
        "checkpoint_seq": {
          "type": "integer"
        },
        "timestamp": {
          "type": "string"
        },
        "milestone": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "locked_baseline",
            "numerator",
            "denominator",
            "percentage",
            "remaining_gates",
            "eta_assumptions",
            "confidence"
          ],
          "properties": {
            "locked_baseline": {
              "type": "string"
            },
            "numerator": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            },
            "denominator": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            },
            "percentage": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "const": "UNKNOWN"
                }
              ]
            },
            "remaining_gates": {
              "type": "array"
            },
            "eta_assumptions": {
              "type": "string"
            },
            "confidence": {
              "type": "string"
            }
          }
        }
      }
    },
    "where": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "head_sha": {
          "type": "string"
        },
        "pr": {
          "type": [
            "string",
            "null"
          ]
        },
        "main": {
          "type": "string"
        }
      }
    },
    "how": {
      "type": "object",
      "required": [
        "tests",
        "gates"
      ],
      "properties": {
        "tests": {},
        "gates": {},
        "reference_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "applicable",
            "entries"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "pinned_sha",
                  "evidence_id",
                  "license_privacy",
                  "epistemic_status",
                  "goal_mapping",
                  "clean_room_evolution",
                  "disposition",
                  "implementation_status"
                ],
                "properties": {
                  "source": {
                    "type": "string"
                  },
                  "pinned_sha": {
                    "type": "string"
                  },
                  "evidence_id": {
                    "type": "string"
                  },
                  "license_privacy": {
                    "type": "string"
                  },
                  "epistemic_status": {
                    "enum": [
                      "Observed",
                      "Inferred",
                      "Unknown"
                    ]
                  },
                  "goal_mapping": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "G1",
                        "G2",
                        "G3"
                      ]
                    }
                  },
                  "clean_room_evolution": {
                    "type": "string"
                  },
                  "disposition": {
                    "enum": [
                      "Adopt",
                      "Adapt",
                      "Defer",
                      "Investigate",
                      "Reject"
                    ]
                  },
                  "implementation_status": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "applicable": {
                "const": false
              }
            },
            "required": [
              "applicable"
            ]
          },
          "then": {
            "properties": {
              "entries": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    "next": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rank",
          "severity",
          "depends_on",
          "action",
          "decision_class"
        ],
        "properties": {
          "rank": {
            "type": "integer"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string"
          },
          "decision_class": {
            "type": "string",
            "enum": [
              "AUTO-CONTINUE",
              "SAFE-TO-APPROVE",
              "REVIEW-REQUIRED",
              "HOLD",
              "NO-ACTION"
            ]
          }
        }
      }
    },
    "recommendation": {
      "type": "string"
    },
    "operator_action": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "contract_version": {
        "const": "1.4.0"
      }
    },
    "required": [
      "contract_version"
    ]
  },
  "then": {
    "required": [
      "contract_version",
      "effort_justification"
    ],
    "properties": {
      "when": {
        "required": [
          "checkpoint_seq",
          "timestamp",
          "milestone"
        ],
        "additionalProperties": false,
        "properties": {
          "checkpoint_seq": {},
          "timestamp": {},
          "milestone": {}
        }
      },
      "how": {
        "required": [
          "tests",
          "gates",
          "reference_ledger"
        ],
        "additionalProperties": false,
        "properties": {
          "tests": {},
          "gates": {},
          "reference_ledger": {}
        }
      }
    }
  }
}
